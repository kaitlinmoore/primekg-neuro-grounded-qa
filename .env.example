# Copy to .env and fill in locally. Never commit .env.
# Key names only; no values here.

# Prime Intellect API key (prime CLI, Prime Inference, Prime sandboxes).
PRIME_API_KEY=

# Anthropic API key for Claude model runs. scripts/run.sh loads .env; pass
# --client.api-key-var NGQ_ANTHROPIC_API_KEY to use it. Deliberately NOT named
# ANTHROPIC_API_KEY: Claude Code reads that name, and a session that inherits it
# bills its own usage to the API key instead of your subscription. run.sh never
# exports ANTHROPIC_API_KEY.
NGQ_ANTHROPIC_API_KEY=

# Key for another OpenAI-compatible model endpoint. Pick any variable name and pass it
# to vf-run with --client.api-key-var <NAME>.
# OPENAI_COMPATIBLE_API_KEY=
