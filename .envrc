# Keep this checkout's venv on the WSL filesystem (fast imports); the code stays on /mnt/c.
export UV_PROJECT_ENVIRONMENT="$HOME/.venvs/ngq-$(basename "$PWD")"
# Graph data (raw downloads, duckdb builds, results) for every checkout and worktree, on the WSL filesystem.
export NGQ_DATA_DIR="$HOME/data/ngq"
